# Optional overrides for existing local folders
# Use absolute paths on macOS for clarity.

# Magnolia WAR file path on host
# MAGNOLIA_WAR_PATH=/absolute/path/to/magnolia-author.war

# Magnolia data folder (contains repositories/, etc.)
# MAGNOLIA_DATA_DIR=/absolute/path/to/existing/magnolia-data

# Light modules folder/repo root
# LM_REPO_DIR=/absolute/path/to/existing/light-modules

# LM repo path where npm run dev should run (must contain package.json)
# LM_DEV_DIR=/absolute/path/to/existing/light-modules/sanofi-lm-dupixent

# Host port for LM dev server
# LM_DEV_PORT=5173
